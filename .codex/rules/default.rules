# Execpolicy：Codex 可在沙箱外自动运行的命令白名单。
# 未命中的命令仍走 approval_policy 的正常审批流程；这里只放低风险、只读的命令。
# 注意 pattern 是前缀匹配：更长的命令同样命中（例如 `ruff check --fix .`）。

prefix_rule(
    pattern = ["ruff", "check"],
    decision = "allow",
    justification = "只读静态检查；--fix 会写盘，如需拦截请收紧 pattern",
    match = ["ruff check .", "ruff check project/src"],
)

prefix_rule(
    pattern = ["ruff", "format", "--check"],
    decision = "allow",
    justification = "只读格式检查",
    match = ["ruff format --check ."],
)

prefix_rule(
    pattern = ["mypy"],
    decision = "allow",
    justification = "只读类型检查",
    match = ["mypy project/src"],
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "只读仓库状态",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "只读差异",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "只读提交历史",
)

# pytest 会执行仓库代码，不自动放行，交由审批流程确认。
