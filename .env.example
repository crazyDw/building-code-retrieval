# 环境变量清单（只放键名与示例值，真实密钥写入 .env，不入库）。
# 键名与《项目概况》第六节一致；默认值取自需求文档中的既定参数。

# ── 生成（DeepSeek API）──
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash
REASONING_EFFORT=low

# ── 嵌入与重排 ──
# 模型路径可填 HF 仓库 ID，也可填本地目录的绝对路径（离线环境用后者）
EMBED_MODEL=BAAI/bge-m3
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_TOKENS=256

# ── 检索参数 ──
CHUNK_MAX_TOKENS=256
CONTEXT_MAX_TOKENS=12000
TOPK_DENSE=30
TOPK_SPARSE=30
RERANK_CANDIDATES=25
TOP_N_DEFAULT=10
RERANK_CANDIDATES_DEEP=40
TOP_N_DEEP=16
REF_EXPAND_LIMIT=5
# 未命中阈值：占位，用自动题库的分数分布标定后回填
SCORE_THRESHOLD=0.0

# ── 存储 ──
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=arch_regulations
SQLITE_PATH=./data/arch_regulations.sqlite
STANDARD_MAP_PATH=./data/standard_map.csv

# ── 运行 ──
DEVICE=cuda
# true 时跳过模型加载与预热、使用 _dev 后缀的数据源，结果不得作为质量依据
DEV_MODE=false
